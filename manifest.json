{
  "manifest_version": 3,
  "name": "GW-OTP",
  "version": "1.0.0",
  "description": "Manage TOTP/HOTP authentication codes locally, encrypted with your master password. Nothing is synced to the cloud.",
  "permissions": ["storage", "activeTab", "alarms"],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
